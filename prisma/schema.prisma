// ==========================================================
// BioSteel de Colombia S.A.S — Modelo de datos (Fase 1)
// Flujo de caja: Cartera, CxP, Recaudos, Pagos, Retenciones
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============== ENUMS ===============

enum TipoSede {
  administrativa
  bodega
}

enum TipoPersona {
  natural
  juridica
}

enum CategoriaCliente {
  clinica_ips
  eps_aseguradora
  distribuidor
  cirujano_particular
}

enum TipoProveedor {
  nacional
  importado
}

enum OrigenFactura {
  directa
  consignacion
}

enum EstadoFactura {
  corriente
  abonada_parcial
  en_mora
  vencida
  en_glosa
  cancelada
}

enum EstadoDocumento {
  vigente
  proximo_vencer
  vencido
  pagado_parcial
  pagado
}

enum EstadoGlosa {
  abierta
  en_conciliacion
  conciliada
  aceptada
}

enum TipoNota {
  credito
  debito
}

enum MedioPago {
  transferencia
  cheque
  efectivo
  consignacion
}

enum TipoRetencion {
  retefuente
  reteiva
  reteica
}

enum AlcancePermiso {
  todos
  propio
  ninguno
}

enum TipoMovimiento {
  ingreso
  egreso
}

// =============== 1. ORGANIZACIÓN ===============

model Empresa {
  id          Int     @id @default(autoincrement())
  razonSocial String
  nit         String  @unique
  sedes       Sede[]
  createdAt   DateTime @default(now())
}

model Sede {
  id        Int      @id @default(autoincrement())
  nombre    String
  tipo      TipoSede
  ciudad    String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId Int
  activo    Boolean  @default(true)

  usuarios  Usuario[]
  cuentas   CuentaBancaria[]
  facturas  FacturaVenta[]

  @@index([empresaId])
}

model CuentaBancaria {
  id       Int      @id @default(autoincrement())
  banco    String
  numero   String
  moneda   String   @default("COP")
  sede     Sede     @relation(fields: [sedeId], references: [id])
  sedeId   Int
  activo   Boolean  @default(true)

  recaudos Recaudo[]
  pagos    Pago[]

  @@index([sedeId])
}

model Moneda {
  codigo  String  @id // COP, USD, EUR
  nombre  String
  simbolo String
  tasas   TasaCambio[]
}

model TasaCambio {
  id            Int      @id @default(autoincrement())
  moneda        Moneda   @relation(fields: [monedaCodigo], references: [codigo])
  monedaCodigo  String
  fecha         DateTime @db.Date
  valorCop      Decimal  @db.Decimal(18, 4)

  @@unique([monedaCodigo, fecha])
  @@index([fecha])
}

model ConceptoRetencion {
  id          Int           @id @default(autoincrement())
  nombre      String
  tipo        TipoRetencion
  porcentaje  Decimal       @db.Decimal(7, 4)
  activo      Boolean       @default(true)
  retenciones RecaudoRetencion[]
}

// =============== 2. SEGURIDAD ===============

model Usuario {
  id              Int       @id @default(autoincrement())
  nombre          String
  email           String    @unique
  passwordHash    String
  rol             Rol       @relation(fields: [rolId], references: [id])
  rolId           Int
  sede            Sede?     @relation(fields: [sedeId], references: [id])
  sedeId          Int?      // null = todas las sedes (alcance global)
  dobleFactor     Boolean   @default(false)
  totpSecret      String?   // cifrado a nivel de app (ver BIO-SEC-013)
  intentosFallidos Int      @default(0)
  bloqueadoHasta  DateTime?
  ultimoAcceso    DateTime?
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sesiones        Sesion[]
  logs            LogAuditoria[]
  vendedor        Vendedor?
  recaudosCreados Recaudo[]
  pagosCreados    Pago[]

  @@index([rolId])
}

model Rol {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  sistema   Boolean  @default(false) // roles base no eliminables
  usuarios  Usuario[]
  permisos  RolPermiso[]
  createdAt DateTime @default(now())
}

model Permiso {
  id          Int      @id @default(autoincrement())
  clave       String   @unique // p. ej. "recaudo.create"
  modulo      String
  descripcion String
  roles       RolPermiso[]
}

model RolPermiso {
  id        Int            @id @default(autoincrement())
  rol       Rol            @relation(fields: [rolId], references: [id], onDelete: Cascade)
  rolId     Int
  permiso   Permiso        @relation(fields: [permisoId], references: [id], onDelete: Cascade)
  permisoId Int
  alcance   AlcancePermiso @default(ninguno)

  @@unique([rolId, permisoId])
  @@index([rolId])
}

// Sesión: token opaco; en la BD solo se guarda su hash (BIO-SEC-015)
model Sesion {
  id        String   @id // hash SHA-256 del token de sesión
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId Int
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([expiresAt])
}

// Auditoría inmutable de operaciones sensibles (BIO-SEC-007)
model LogAuditoria {
  id             BigInt   @id @default(autoincrement())
  usuario        Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId      Int?
  accion         String   // "recaudo.crear", "usuario.login", ...
  entidad        String?
  entidadId      String?
  valorAnterior  Json?
  valorNuevo     Json?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([usuarioId])
  @@index([entidad, entidadId])
  @@index([createdAt])
}

// =============== 3. TERCEROS ===============

model Tercero {
  id           Int      @id @default(autoincrement())
  nit          String   @unique
  nombre       String
  tipoPersona  TipoPersona @default(juridica)
  ciudad       String?
  esCliente    Boolean  @default(false)
  esProveedor  Boolean  @default(false)
  esInterno    Boolean  @default(false) // parte relacionada: se ocultan sus anticipos
  esGrupo      Boolean  @default(false) // IPS del grupo empresarial
  createdAt    DateTime @default(now())

  clientePerfil   ClientePerfil?
  proveedorPerfil ProveedorPerfil?
  contactos       Contacto[]
  facturas        FacturaVenta[]
  recaudos        Recaudo[]
  documentosCxp   DocumentoCxp[]
  pagos           Pago[]
  anticipos       Anticipo[]

  @@index([nombre])
}

model ClientePerfil {
  tercero      Tercero          @relation(fields: [terceroId], references: [id], onDelete: Cascade)
  terceroId    Int              @id
  categoria    CategoriaCliente
  vendedor     Vendedor?        @relation(fields: [vendedorId], references: [id])
  vendedorId   Int?
  cupoCredito  Decimal          @default(0) @db.Decimal(18, 2)
  diasCredito  Int              @default(30)
  bloqueado    Boolean          @default(false)

  @@index([vendedorId])
}

model ProveedorPerfil {
  tercero        Tercero       @relation(fields: [terceroId], references: [id], onDelete: Cascade)
  terceroId      Int           @id
  tipo           TipoProveedor @default(nacional)
  monedaDefault  String        @default("COP")
  diasCredito    Int           @default(30)
}

model Vendedor {
  id         Int      @id @default(autoincrement())
  nombre     String
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId  Int?     @unique
  activo     Boolean  @default(true)

  clientes   ClientePerfil[]
  facturas   FacturaVenta[]
}

model Contacto {
  id        Int     @id @default(autoincrement())
  tercero   Tercero @relation(fields: [terceroId], references: [id], onDelete: Cascade)
  terceroId Int
  nombre    String
  email     String?
  telefono  String?
  cargo     String?

  @@index([terceroId])
}

// =============== 4. CARTERA (CxC) ===============

model FacturaVenta {
  id               Int           @id @default(autoincrement())
  numero           String        @unique
  tercero          Tercero       @relation(fields: [terceroId], references: [id])
  terceroId        Int
  sede             Sede          @relation(fields: [sedeId], references: [id])
  sedeId           Int
  vendedor         Vendedor?     @relation(fields: [vendedorId], references: [id])
  vendedorId       Int?
  origen           OrigenFactura @default(directa)
  fechaEmision     DateTime      @db.Date
  fechaVencimiento DateTime      @db.Date
  moneda           String        @default("COP")
  valorTotal       Decimal       @db.Decimal(18, 2)
  iva              Decimal       @default(0) @db.Decimal(18, 2)
  saldo            Decimal       @db.Decimal(18, 2) // derivado, ver lib de negocio
  estado           EstadoFactura @default(corriente)
  concepto         String?       // "Notas" del reporte SIESA
  plazo            Int?          // días de plazo pactado
  createdAt        DateTime      @default(now())

  aplicaciones RecaudoAplicacion[]
  notas        NotaCd[]
  glosas       Glosa[]

  @@index([terceroId])
  @@index([sedeId])
  @@index([vendedorId])
  @@index([estado])
  @@index([fechaVencimiento])
}

model NotaCd {
  id        Int          @id @default(autoincrement())
  factura   FacturaVenta @relation(fields: [facturaId], references: [id])
  facturaId Int
  tipo      TipoNota
  valor     Decimal      @db.Decimal(18, 2)
  motivo    String
  fecha     DateTime     @default(now()) @db.Date

  @@index([facturaId])
}

model Glosa {
  id          Int          @id @default(autoincrement())
  factura     FacturaVenta @relation(fields: [facturaId], references: [id])
  facturaId   Int
  valor       Decimal      @db.Decimal(18, 2)
  estado      EstadoGlosa  @default(abierta)
  descripcion String?
  fecha       DateTime     @default(now()) @db.Date

  @@index([facturaId])
  @@index([estado])
}

// =============== 5. RECAUDOS ===============

model Recaudo {
  id               Int             @id @default(autoincrement())
  tercero          Tercero         @relation(fields: [terceroId], references: [id])
  terceroId        Int
  cuenta           CuentaBancaria? @relation(fields: [cuentaId], references: [id])
  cuentaId         Int?
  fecha            DateTime        @default(now()) @db.Date
  medio            MedioPago
  valorRecibido    Decimal         @db.Decimal(18, 2)
  totalRetenciones Decimal         @default(0) @db.Decimal(18, 2)
  referencia       String?
  createdBy        Usuario         @relation(fields: [createdById], references: [id])
  createdById      Int
  createdAt        DateTime        @default(now())

  aplicaciones RecaudoAplicacion[]
  retenciones  RecaudoRetencion[]
  anticipo     Anticipo?

  @@index([terceroId])
  @@index([fecha])
}

model RecaudoAplicacion {
  id            Int          @id @default(autoincrement())
  recaudo       Recaudo      @relation(fields: [recaudoId], references: [id], onDelete: Cascade)
  recaudoId     Int
  factura       FacturaVenta @relation(fields: [facturaId], references: [id])
  facturaId     Int
  valorAplicado Decimal      @db.Decimal(18, 2)

  @@index([recaudoId])
  @@index([facturaId])
}

model RecaudoRetencion {
  id         Int               @id @default(autoincrement())
  recaudo    Recaudo           @relation(fields: [recaudoId], references: [id], onDelete: Cascade)
  recaudoId  Int
  concepto   ConceptoRetencion @relation(fields: [conceptoId], references: [id])
  conceptoId Int
  base       Decimal           @db.Decimal(18, 2)
  valor      Decimal           @db.Decimal(18, 2)

  @@index([recaudoId])
}

model Anticipo {
  id        Int      @id @default(autoincrement())
  tercero   Tercero  @relation(fields: [terceroId], references: [id])
  terceroId Int
  recaudo   Recaudo? @relation(fields: [recaudoId], references: [id])
  recaudoId Int?     @unique
  saldo     Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@index([terceroId])
}

// =============== 6. CUENTAS POR PAGAR & PAGOS ===============

model DocumentoCxp {
  id               Int             @id @default(autoincrement())
  numero           String
  proveedor        Tercero         @relation(fields: [proveedorId], references: [id])
  proveedorId      Int
  moneda           String          @default("COP")
  valorOrigen      Decimal         @db.Decimal(18, 2)
  trmCausacion     Decimal         @default(1) @db.Decimal(18, 4)
  valorCop         Decimal         @db.Decimal(18, 2)
  saldo            Decimal         @db.Decimal(18, 2)
  fechaEmision     DateTime        @db.Date
  fechaVencimiento DateTime        @db.Date
  tipo             TipoProveedor   @default(nacional)
  estado           EstadoDocumento @default(vigente)
  concepto         String?         // "Notas" del reporte SIESA
  plazo            Int?            // días de plazo pactado
  createdAt        DateTime        @default(now())

  costos       CostoImportacion[]
  aplicaciones PagoAplicacion[]

  @@unique([numero, proveedorId])
  @@index([proveedorId])
  @@index([estado])
  @@index([fechaVencimiento])
}

model CostoImportacion {
  id          Int          @id @default(autoincrement())
  documento   DocumentoCxp @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  documentoId Int
  concepto    String // flete, arancel, nacionalización...
  valor       Decimal      @db.Decimal(18, 2)

  @@index([documentoId])
}

model Pago {
  id           Int             @id @default(autoincrement())
  proveedor    Tercero         @relation(fields: [proveedorId], references: [id])
  proveedorId  Int
  cuenta       CuentaBancaria? @relation(fields: [cuentaId], references: [id])
  cuentaId     Int?
  moneda       String          @default("COP")
  trmPago      Decimal         @default(1) @db.Decimal(18, 4)
  valorOrigen  Decimal         @db.Decimal(18, 2)
  valorCop     Decimal         @db.Decimal(18, 2)
  fecha        DateTime        @default(now()) @db.Date
  createdBy    Usuario         @relation(fields: [createdById], references: [id])
  createdById  Int
  createdAt    DateTime        @default(now())

  aplicaciones     PagoAplicacion[]
  diferenciaCambio DiferenciaCambio?

  @@index([proveedorId])
  @@index([fecha])
}

model PagoAplicacion {
  id            Int          @id @default(autoincrement())
  pago          Pago         @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  pagoId        Int
  documento     DocumentoCxp @relation(fields: [documentoId], references: [id])
  documentoId   Int
  valorAplicado Decimal      @db.Decimal(18, 2)

  @@index([pagoId])
  @@index([documentoId])
}

model DiferenciaCambio {
  id     Int     @id @default(autoincrement())
  pago   Pago    @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  pagoId Int     @unique
  valor  Decimal @db.Decimal(18, 2) // + ingreso / - gasto
}

// =============== 8. OBLIGACIONES FINANCIERAS ===============
// Créditos, leasing y tarjetas. Alimentado de los planes de amortización.
model ObligacionFinanciera {
  id               Int       @id @default(autoincrement())
  entidad          String
  tipo             String    // credito | credito_fng | leasing | tarjeta
  numero           String    @unique
  moneda           String    @default("COP")
  montoInicial     Decimal?  @db.Decimal(18, 2)
  saldoCapital     Decimal   @db.Decimal(18, 2)
  tasaEA           Decimal?  @db.Decimal(7, 4) // % efectiva anual
  cuotaMensual     Decimal?  @db.Decimal(18, 2)
  diaPago          Int?      // día del mes de la cuota
  periodicidad     String    @default("mensual")
  fechaDesembolso  DateTime? @db.Date
  fechaVencimiento DateTime? @db.Date
  corte            DateTime? @db.Date
  estado           String    @default("al_dia") // al_dia | en_mora
  notas            String?
  createdAt        DateTime  @default(now())
}

// Impuestos pendientes por mes (histórico). Entidad = BioSteel (por ahora).
model ImpuestoMensual {
  id          Int       @id @default(autoincrement())
  entidad     String    @default("BioSteel")
  anio        Int
  mes         Int       // 1–12
  fecha       DateTime  @db.Date
  retencion   Decimal   @default(0) @db.Decimal(18, 2)
  iva         Decimal   @default(0) @db.Decimal(18, 2)
  ica         Decimal   @default(0) @db.Decimal(18, 2)
  renta       Decimal   @default(0) @db.Decimal(18, 2)
  granTotal   Decimal?  @db.Decimal(18, 2) // valor reportado en el Excel (inconsistente)
  vencimiento DateTime? @db.Date

  @@unique([entidad, anio, mes])
  @@index([anio, mes])
}

// Bitácora de notificaciones enviadas (evita duplicados).
model NotificacionEnviada {
  id            Int      @id @default(autoincrement())
  clave         String   @unique // p.ej. "obligacion:296446:2026-09-19"
  tipo          String
  referencia    String
  fechaEvento   DateTime @db.Date
  destinatarios String
  asunto        String
  estado        String   @default("enviada") // enviada | error
  error         String?
  enviadaEn     DateTime @default(now())

  @@index([enviadaEn])
}

// Configuración editable (desde la app) de los recordatorios de pago.
// Fila única (id = 1). Si no existe, se usan los valores de entorno como respaldo.
model ConfigNotificaciones {
  id             Int      @id @default(1)
  diasAntes      Int      @default(5)
  destinatarios  String // correos separados por coma
  actualizadoEn  DateTime @updatedAt
  actualizadoPor String?
}

// =============== 7. FLUJO DE CAJA & PRESUPUESTO ===============
// Modelo de flujo por movimientos + presupuesto mensual por grupo.
// (Alimentado desde el Excel "PRESUPUESTO 2026": TBFlujo, TBRecaudos,
//  Detalle presupuesto, Parametros.)

// Grupo/categoría de flujo (NOMINA, PROVEEDORES_OPERACIÓN, IMPUESTOS, ...)
model CategoriaFlujo {
  id           Int            @id @default(autoincrement())
  nombre       String         @unique
  tipo         TipoMovimiento @default(egreso)
  orden        Int            @default(0)
  activo       Boolean        @default(true)

  movimientos  MovimientoFlujo[]
  presupuestos PresupuestoMensual[]
}

// Movimiento de caja (ingreso o egreso). Ledger denormalizado: el tercero
// se guarda por nombre/NIT tal como viene del ERP (no todos existen como Tercero).
model MovimientoFlujo {
  id            Int             @id @default(autoincrement())
  fecha         DateTime        @db.Date
  anio          Int
  mes           Int             // 1–12
  tipo          TipoMovimiento
  categoria     CategoriaFlujo? @relation(fields: [categoriaId], references: [id])
  categoriaId   Int?
  terceroNombre String
  nit           String?
  beneficiario  String?
  detalle       String?         // "DETALLE MOVIMIENTO" del ERP
  observacion   String?         // "OBSERVACIÓN"
  valor         Decimal         @db.Decimal(18, 2)
  saldo         Decimal?        @db.Decimal(18, 2) // saldo corrido informativo del ERP
  createdAt     DateTime        @default(now())

  @@index([anio, mes])
  @@index([tipo])
  @@index([categoriaId])
}

// Presupuesto de egresos por mes / grupo / tercero.
model PresupuestoMensual {
  id            Int            @id @default(autoincrement())
  anio          Int
  mes           Int            // 1–12
  categoria     CategoriaFlujo @relation(fields: [categoriaId], references: [id])
  categoriaId   Int
  terceroNombre String?
  valor         Decimal        @db.Decimal(18, 2)

  @@index([anio, mes])
  @@index([categoriaId])
}
