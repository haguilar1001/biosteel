// ==========================================================
// BioSteel de Colombia S.A.S — Modelo de datos (Fase 1)
// Flujo de caja: Cartera, CxP, Recaudos, Pagos, Retenciones
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============== ENUMS ===============

enum TipoSede {
  administrativa
  bodega
}

enum TipoPersona {
  natural
  juridica
}

enum CategoriaCliente {
  clinica_ips
  eps_aseguradora
  distribuidor
  cirujano_particular
}

enum TipoProveedor {
  nacional
  importado
}

enum OrigenFactura {
  directa
  consignacion
}

enum EstadoFactura {
  corriente
  abonada_parcial
  en_mora
  vencida
  en_glosa
  cancelada
}

enum EstadoDocumento {
  vigente
  proximo_vencer
  vencido
  pagado_parcial
  pagado
}

enum EstadoGlosa {
  abierta
  en_conciliacion
  conciliada
  aceptada
}

enum TipoNota {
  credito
  debito
}

enum MedioPago {
  transferencia
  cheque
  efectivo
  consignacion
}

enum TipoRetencion {
  retefuente
  reteiva
  reteica
}

enum AlcancePermiso {
  todos
  propio
  ninguno
}

enum TipoMovimiento {
  ingreso
  egreso
}

enum EstadoInventario {
  activo
  en_reparacion
  de_baja
  pendiente
}

enum TipoItemInventario {
  equipo
  accesorio
}

enum TipoNovedad {
  compra // Alta / ingreso de un equipo nuevo
  baja // Retiro definitivo del inventario
  dano // Reporte de daño
  reparacion // Envío a reparación
  retorno_reparacion // Retorno de reparación (queda activo)
  traslado // Movimiento entre sedes
}

// =============== 1. ORGANIZACIÓN ===============

model Empresa {
  id          Int      @id @default(autoincrement())
  razonSocial String
  nit         String   @unique
  sedes       Sede[]
  createdAt   DateTime @default(now())
}

model Sede {
  id        Int      @id @default(autoincrement())
  nombre    String
  tipo      TipoSede
  ciudad    String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId Int
  activo    Boolean  @default(true)

  usuarios Usuario[]
  cuentas  CuentaBancaria[]
  facturas FacturaVenta[]
  equipos  EquipoInventario[]

  @@index([empresaId])
}

model CuentaBancaria {
  id     Int     @id @default(autoincrement())
  banco  String
  numero String
  moneda String  @default("COP")
  sede   Sede    @relation(fields: [sedeId], references: [id])
  sedeId Int
  activo Boolean @default(true)

  recaudos Recaudo[]
  pagos    Pago[]

  @@index([sedeId])
}

model Moneda {
  codigo  String       @id // COP, USD, EUR
  nombre  String
  simbolo String
  tasas   TasaCambio[]
}

model TasaCambio {
  id           Int      @id @default(autoincrement())
  moneda       Moneda   @relation(fields: [monedaCodigo], references: [codigo])
  monedaCodigo String
  fecha        DateTime @db.Date
  valorCop     Decimal  @db.Decimal(18, 4)

  @@unique([monedaCodigo, fecha])
  @@index([fecha])
}

model ConceptoRetencion {
  id          Int                @id @default(autoincrement())
  nombre      String
  tipo        TipoRetencion
  porcentaje  Decimal            @db.Decimal(7, 4)
  activo      Boolean            @default(true)
  retenciones RecaudoRetencion[]
}

// =============== 2. SEGURIDAD ===============

model Usuario {
  id               Int       @id @default(autoincrement())
  nombre           String
  email            String    @unique
  passwordHash     String
  rol              Rol       @relation(fields: [rolId], references: [id])
  rolId            Int
  sede             Sede?     @relation(fields: [sedeId], references: [id])
  sedeId           Int? // null = todas las sedes (alcance global)
  dobleFactor      Boolean   @default(false)
  totpSecret       String? // cifrado a nivel de app (ver BIO-SEC-013)
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?
  ultimoAcceso     DateTime?
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sesiones        Sesion[]
  logs            LogAuditoria[]
  vendedor        Vendedor?
  recaudosCreados Recaudo[]
  pagosCreados    Pago[]
  novedadesInv    NovedadInventario[]

  @@index([rolId])
}

model Rol {
  id        Int          @id @default(autoincrement())
  nombre    String       @unique
  sistema   Boolean      @default(false) // roles base no eliminables
  usuarios  Usuario[]
  permisos  RolPermiso[]
  createdAt DateTime     @default(now())
}

model Permiso {
  id          Int          @id @default(autoincrement())
  clave       String       @unique // p. ej. "recaudo.create"
  modulo      String
  descripcion String
  roles       RolPermiso[]
}

model RolPermiso {
  id        Int            @id @default(autoincrement())
  rol       Rol            @relation(fields: [rolId], references: [id], onDelete: Cascade)
  rolId     Int
  permiso   Permiso        @relation(fields: [permisoId], references: [id], onDelete: Cascade)
  permisoId Int
  alcance   AlcancePermiso @default(ninguno)

  @@unique([rolId, permisoId])
  @@index([rolId])
}

// Sesión: token opaco; en la BD solo se guarda su hash (BIO-SEC-015)
model Sesion {
  id        String   @id // hash SHA-256 del token de sesión
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId Int
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([expiresAt])
}

// Auditoría inmutable de operaciones sensibles (BIO-SEC-007)
model LogAuditoria {
  id            BigInt   @id @default(autoincrement())
  usuario       Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId     Int?
  accion        String // "recaudo.crear", "usuario.login", ...
  entidad       String?
  entidadId     String?
  valorAnterior Json?
  valorNuevo    Json?
  ip            String?
  createdAt     DateTime @default(now())

  @@index([usuarioId])
  @@index([entidad, entidadId])
  @@index([createdAt])
}

// =============== 3. TERCEROS ===============

model Tercero {
  id          Int         @id @default(autoincrement())
  nit         String      @unique
  nombre      String
  tipoPersona TipoPersona @default(juridica)
  ciudad      String?
  esCliente   Boolean     @default(false)
  esProveedor Boolean     @default(false)
  esInterno   Boolean     @default(false) // parte relacionada: se ocultan sus anticipos
  esGrupo     Boolean     @default(false) // IPS del grupo empresarial
  createdAt   DateTime    @default(now())

  clientePerfil   ClientePerfil?
  proveedorPerfil ProveedorPerfil?
  contactos       Contacto[]
  facturas        FacturaVenta[]
  recaudos        Recaudo[]
  documentosCxp   DocumentoCxp[]
  pagos           Pago[]
  anticipos       Anticipo[]

  @@index([nombre])
}

model ClientePerfil {
  tercero     Tercero          @relation(fields: [terceroId], references: [id], onDelete: Cascade)
  terceroId   Int              @id
  categoria   CategoriaCliente
  vendedor    Vendedor?        @relation(fields: [vendedorId], references: [id])
  vendedorId  Int?
  cupoCredito Decimal          @default(0) @db.Decimal(18, 2)
  diasCredito Int              @default(30)
  bloqueado   Boolean          @default(false)

  @@index([vendedorId])
}

model ProveedorPerfil {
  tercero       Tercero       @relation(fields: [terceroId], references: [id], onDelete: Cascade)
  terceroId     Int           @id
  tipo          TipoProveedor @default(nacional)
  monedaDefault String        @default("COP")
  diasCredito   Int           @default(30)
}

model Vendedor {
  id        Int      @id @default(autoincrement())
  nombre    String
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId Int?     @unique
  activo    Boolean  @default(true)

  clientes ClientePerfil[]
  facturas FacturaVenta[]
}

model Contacto {
  id        Int     @id @default(autoincrement())
  tercero   Tercero @relation(fields: [terceroId], references: [id], onDelete: Cascade)
  terceroId Int
  nombre    String
  email     String?
  telefono  String?
  cargo     String?

  @@index([terceroId])
}

// =============== 4. CARTERA (CxC) ===============

model FacturaVenta {
  id               Int           @id @default(autoincrement())
  numero           String        @unique
  tercero          Tercero       @relation(fields: [terceroId], references: [id])
  terceroId        Int
  sede             Sede          @relation(fields: [sedeId], references: [id])
  sedeId           Int
  vendedor         Vendedor?     @relation(fields: [vendedorId], references: [id])
  vendedorId       Int?
  origen           OrigenFactura @default(directa)
  fechaEmision     DateTime      @db.Date
  fechaVencimiento DateTime      @db.Date
  moneda           String        @default("COP")
  valorTotal       Decimal       @db.Decimal(18, 2)
  iva              Decimal       @default(0) @db.Decimal(18, 2)
  saldo            Decimal       @db.Decimal(18, 2) // derivado, ver lib de negocio
  estado           EstadoFactura @default(corriente)
  concepto         String? // "Notas" del reporte SIESA
  plazo            Int? // días de plazo pactado
  createdAt        DateTime      @default(now())

  aplicaciones RecaudoAplicacion[]
  notas        NotaCd[]
  glosas       Glosa[]

  @@index([terceroId])
  @@index([sedeId])
  @@index([vendedorId])
  @@index([estado])
  @@index([fechaVencimiento])
}

model NotaCd {
  id        Int          @id @default(autoincrement())
  factura   FacturaVenta @relation(fields: [facturaId], references: [id])
  facturaId Int
  tipo      TipoNota
  valor     Decimal      @db.Decimal(18, 2)
  motivo    String
  fecha     DateTime     @default(now()) @db.Date

  @@index([facturaId])
}

model Glosa {
  id          Int          @id @default(autoincrement())
  factura     FacturaVenta @relation(fields: [facturaId], references: [id])
  facturaId   Int
  valor       Decimal      @db.Decimal(18, 2)
  estado      EstadoGlosa  @default(abierta)
  descripcion String?
  fecha       DateTime     @default(now()) @db.Date

  @@index([facturaId])
  @@index([estado])
}

// =============== 5. RECAUDOS ===============

model Recaudo {
  id               Int             @id @default(autoincrement())
  tercero          Tercero         @relation(fields: [terceroId], references: [id])
  terceroId        Int
  cuenta           CuentaBancaria? @relation(fields: [cuentaId], references: [id])
  cuentaId         Int?
  fecha            DateTime        @default(now()) @db.Date
  medio            MedioPago
  valorRecibido    Decimal         @db.Decimal(18, 2)
  totalRetenciones Decimal         @default(0) @db.Decimal(18, 2)
  referencia       String?
  createdBy        Usuario         @relation(fields: [createdById], references: [id])
  createdById      Int
  createdAt        DateTime        @default(now())

  aplicaciones RecaudoAplicacion[]
  retenciones  RecaudoRetencion[]
  anticipo     Anticipo?

  @@index([terceroId])
  @@index([fecha])
}

model RecaudoAplicacion {
  id            Int          @id @default(autoincrement())
  recaudo       Recaudo      @relation(fields: [recaudoId], references: [id], onDelete: Cascade)
  recaudoId     Int
  factura       FacturaVenta @relation(fields: [facturaId], references: [id])
  facturaId     Int
  valorAplicado Decimal      @db.Decimal(18, 2)

  @@index([recaudoId])
  @@index([facturaId])
}

model RecaudoRetencion {
  id         Int               @id @default(autoincrement())
  recaudo    Recaudo           @relation(fields: [recaudoId], references: [id], onDelete: Cascade)
  recaudoId  Int
  concepto   ConceptoRetencion @relation(fields: [conceptoId], references: [id])
  conceptoId Int
  base       Decimal           @db.Decimal(18, 2)
  valor      Decimal           @db.Decimal(18, 2)

  @@index([recaudoId])
}

model Anticipo {
  id        Int      @id @default(autoincrement())
  tercero   Tercero  @relation(fields: [terceroId], references: [id])
  terceroId Int
  recaudo   Recaudo? @relation(fields: [recaudoId], references: [id])
  recaudoId Int?     @unique
  saldo     Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@index([terceroId])
}

// =============== 6. CUENTAS POR PAGAR & PAGOS ===============

model DocumentoCxp {
  id               Int             @id @default(autoincrement())
  numero           String
  proveedor        Tercero         @relation(fields: [proveedorId], references: [id])
  proveedorId      Int
  moneda           String          @default("COP")
  valorOrigen      Decimal         @db.Decimal(18, 2)
  trmCausacion     Decimal         @default(1) @db.Decimal(18, 4)
  valorCop         Decimal         @db.Decimal(18, 2)
  saldo            Decimal         @db.Decimal(18, 2)
  fechaEmision     DateTime        @db.Date
  fechaVencimiento DateTime        @db.Date
  tipo             TipoProveedor   @default(nacional)
  estado           EstadoDocumento @default(vigente)
  concepto         String? // "Notas" del reporte SIESA
  plazo            Int? // días de plazo pactado
  createdAt        DateTime        @default(now())

  costos       CostoImportacion[]
  aplicaciones PagoAplicacion[]

  @@unique([numero, proveedorId])
  @@index([proveedorId])
  @@index([estado])
  @@index([fechaVencimiento])
}

model CostoImportacion {
  id          Int          @id @default(autoincrement())
  documento   DocumentoCxp @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  documentoId Int
  concepto    String // flete, arancel, nacionalización...
  valor       Decimal      @db.Decimal(18, 2)

  @@index([documentoId])
}

model Pago {
  id          Int             @id @default(autoincrement())
  proveedor   Tercero         @relation(fields: [proveedorId], references: [id])
  proveedorId Int
  cuenta      CuentaBancaria? @relation(fields: [cuentaId], references: [id])
  cuentaId    Int?
  moneda      String          @default("COP")
  trmPago     Decimal         @default(1) @db.Decimal(18, 4)
  valorOrigen Decimal         @db.Decimal(18, 2)
  valorCop    Decimal         @db.Decimal(18, 2)
  fecha       DateTime        @default(now()) @db.Date
  createdBy   Usuario         @relation(fields: [createdById], references: [id])
  createdById Int
  createdAt   DateTime        @default(now())

  aplicaciones     PagoAplicacion[]
  diferenciaCambio DiferenciaCambio?

  @@index([proveedorId])
  @@index([fecha])
}

model PagoAplicacion {
  id            Int          @id @default(autoincrement())
  pago          Pago         @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  pagoId        Int
  documento     DocumentoCxp @relation(fields: [documentoId], references: [id])
  documentoId   Int
  valorAplicado Decimal      @db.Decimal(18, 2)

  @@index([pagoId])
  @@index([documentoId])
}

model DiferenciaCambio {
  id     Int     @id @default(autoincrement())
  pago   Pago    @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  pagoId Int     @unique
  valor  Decimal @db.Decimal(18, 2) // + ingreso / - gasto
}

// =============== 8. OBLIGACIONES FINANCIERAS ===============
// Créditos, leasing y tarjetas. Alimentado de los planes de amortización.
model ObligacionFinanciera {
  id               Int       @id @default(autoincrement())
  entidad          String
  tipo             String // credito | credito_fng | leasing | tarjeta
  numero           String    @unique
  moneda           String    @default("COP")
  montoInicial     Decimal?  @db.Decimal(18, 2)
  saldoCapital     Decimal   @db.Decimal(18, 2)
  tasaEA           Decimal?  @db.Decimal(7, 4) // % efectiva anual
  cuotaMensual     Decimal?  @db.Decimal(18, 2)
  diaPago          Int? // día del mes de la cuota
  periodicidad     String    @default("mensual")
  fechaDesembolso  DateTime? @db.Date
  fechaVencimiento DateTime? @db.Date
  corte            DateTime? @db.Date
  estado           String    @default("al_dia") // al_dia | en_mora
  notas            String?
  createdAt        DateTime  @default(now())
}

// Impuestos pendientes por mes (histórico). Entidad = BioSteel (por ahora).
model ImpuestoMensual {
  id          Int       @id @default(autoincrement())
  entidad     String    @default("BioSteel")
  anio        Int
  mes         Int // 1–12
  fecha       DateTime  @db.Date
  retencion   Decimal   @default(0) @db.Decimal(18, 2)
  iva         Decimal   @default(0) @db.Decimal(18, 2)
  ica         Decimal   @default(0) @db.Decimal(18, 2)
  renta       Decimal   @default(0) @db.Decimal(18, 2)
  granTotal   Decimal?  @db.Decimal(18, 2) // valor reportado en el Excel (inconsistente)
  vencimiento DateTime? @db.Date

  @@unique([entidad, anio, mes])
  @@index([anio, mes])
}

// Bitácora de notificaciones enviadas (evita duplicados).
model NotificacionEnviada {
  id            Int      @id @default(autoincrement())
  clave         String   @unique // p.ej. "obligacion:296446:2026-09-19"
  tipo          String
  referencia    String
  fechaEvento   DateTime @db.Date
  destinatarios String
  asunto        String
  estado        String   @default("enviada") // enviada | error
  error         String?
  enviadaEn     DateTime @default(now())

  @@index([enviadaEn])
}

// Configuración editable (desde la app) de los recordatorios de pago.
// Fila única (id = 1). Si no existe, se usan los valores de entorno como respaldo.
model ConfigNotificaciones {
  id             Int      @id @default(1)
  diasAntes      Int      @default(5)
  destinatarios  String // correos separados por coma
  actualizadoEn  DateTime @updatedAt
  actualizadoPor String?
}

// =============== 7. FLUJO DE CAJA & PRESUPUESTO ===============
// Modelo de flujo por movimientos + presupuesto mensual por grupo.
// (Alimentado desde el Excel "PRESUPUESTO 2026": TBFlujo, TBRecaudos,
//  Detalle presupuesto, Parametros.)

// Grupo/categoría de flujo (NOMINA, PROVEEDORES_OPERACIÓN, IMPUESTOS, ...)
model CategoriaFlujo {
  id     Int            @id @default(autoincrement())
  nombre String         @unique
  tipo   TipoMovimiento @default(egreso)
  orden  Int            @default(0)
  activo Boolean        @default(true)

  movimientos  MovimientoFlujo[]
  presupuestos PresupuestoMensual[]
}

// Movimiento de caja (ingreso o egreso). Ledger denormalizado: el tercero
// se guarda por nombre/NIT tal como viene del ERP (no todos existen como Tercero).
model MovimientoFlujo {
  id            Int             @id @default(autoincrement())
  documento     String?         @unique // Nº de comprobante SIESA (OCC-/NGC-/NBA-/PEL-/RDC-…) — idempotencia del importador
  fecha         DateTime        @db.Date
  anio          Int
  mes           Int // 1–12
  tipo          TipoMovimiento
  categoria     CategoriaFlujo? @relation(fields: [categoriaId], references: [id])
  categoriaId   Int?
  terceroNombre String
  nit           String?
  beneficiario  String?
  detalle       String? // "DETALLE MOVIMIENTO" del ERP
  observacion   String? // "OBSERVACIÓN"
  valor         Decimal         @db.Decimal(18, 2)
  saldo         Decimal?        @db.Decimal(18, 2) // saldo corrido informativo del ERP
  createdAt     DateTime        @default(now())

  @@index([anio, mes])
  @@index([tipo])
  @@index([categoriaId])
}

// Presupuesto de egresos por mes / grupo / tercero.
model PresupuestoMensual {
  id            Int            @id @default(autoincrement())
  anio          Int
  mes           Int // 1–12
  categoria     CategoriaFlujo @relation(fields: [categoriaId], references: [id])
  categoriaId   Int
  terceroNombre String?
  valor         Decimal        @db.Decimal(18, 2)

  @@index([anio, mes])
  @@index([categoriaId])
}

// =============== 9. VENTAS (por línea / por cliente) ===============
// Agregados mensuales del reporte "Venta por línea" (SIESA). El detalle es
// enorme (decenas de miles de renglones), así que se pre-agrega al importar.
// `valor` = suma de "Valor subtotal local" (neto de notas crédito del período).

// Venta neta por línea de producto y mes.
// valor = Σ(Valor subtotal local) − Σ(NOTA_CREDITO) ; costo = Σ(Costo promedio total).
model VentaLinea {
  id    Int     @id @default(autoincrement())
  anio  Int
  mes   Int // 1–12
  linea String // p.ej. "2002 - TRAUMA/ORTOPEDIA"
  valor Decimal @db.Decimal(18, 2) // venta neta
  costo Decimal @default(0) @db.Decimal(18, 2)

  @@unique([anio, mes, linea])
  @@index([anio, mes])
}

// Venta neta por cliente y mes (para el comparativo ventas vs recaudos).
model VentaCliente {
  id            Int     @id @default(autoincrement())
  anio          Int
  mes           Int // 1–12
  clienteNombre String
  nit           String?
  valor         Decimal @db.Decimal(18, 2) // venta neta
  costo         Decimal @default(0) @db.Decimal(18, 2)

  @@unique([anio, mes, clienteNombre])
  @@index([anio, mes])
}

// Venta neta y costo por MARCA (proveedor/casa del producto) y mes.
// Alimenta el "Informe de Consumos" (% Utilidad por proveedor).
model VentaMarca {
  id    Int     @id @default(autoincrement())
  anio  Int
  mes   Int // 1–12
  marca String // p.ej. "1003 - SAMPEDRO"
  valor Decimal @db.Decimal(18, 2) // venta neta
  costo Decimal @default(0) @db.Decimal(18, 2)

  @@unique([anio, mes, marca])
  @@index([anio, mes])
}

// Venta neta y costo por MARCA (proveedor) × IPS (cliente de despacho) y mes.
// Permite desplegar cada proveedor por IPS en el Informe de Consumos.
model VentaMarcaIps {
  id    Int     @id @default(autoincrement())
  anio  Int
  mes   Int // 1–12
  marca String // p.ej. "1003 - SAMPEDRO"
  ips   String // razón social del cliente de despacho (la IPS)
  valor Decimal @db.Decimal(18, 2) // venta neta
  costo Decimal @default(0) @db.Decimal(18, 2)

  @@unique([anio, mes, marca, ips])
  @@index([anio, mes])
  @@index([marca])
}

// Estado operativo de un proveedor/MARCA (ACTIVO / INACTIVO / CON RESTRICCIÓN)
// con su motivo. Editable en la app; se cruza con la venta por marca para KPIs
// de riesgo de suministro. `marca` = el mismo string de VentaMarca.
model ProveedorEstado {
  id        Int      @id @default(autoincrement())
  marca     String   @unique
  estado    String   @default("ACTIVO") // ACTIVO | INACTIVO | CON RESTRICCIÓN
  motivo    String   @default("") // EN OPERACIÓN | EMBARGO | SIN OPERACIÓN | COBRO PREJURIDICO | ACUERDO DE PAGO
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([estado])
}

// Personalización del menú (sobre el catálogo del código). Campos nulos = usar
// el valor por defecto del código. No pueden crear rutas ni permisos nuevos.
model MenuGrupoCfg {
  clave   String  @id // id del grupo (tesoreria, comercial, admin…)
  label   String?
  icon    String?
  orden   Int?
  visible Boolean @default(true)
}

model MenuItemCfg {
  href       String  @id // ruta del ítem (clave estable)
  label      String?
  grupoClave String? // grupo destino (mover entre grupos)
  orden      Int?
  visible    Boolean @default(true)
}

// Ajuste manual de venta neta por período (para cuadrar con Power BI cuando las
// exclusiones exactas no se conocen). Al reliquidar se suma como una línea
// sintética a los agregados. `valor` positivo sube la venta neta, negativo la baja.
model AjusteVenta {
  id        Int      @id @default(autoincrement())
  anio      Int
  mes       Int // 1–12
  concepto  String   @default("AJUSTE")
  valor     Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@index([anio])
}

// =============== 10. ESTADO DE RESULTADOS (PyG) ===============
// Un registro por mes. Los totales principales quedan en columnas; el árbol
// completo de cuentas (para la vista detallada) se guarda en `detalle` (JSON).
model EstadoResultados {
  id                  Int      @id @default(autoincrement())
  anio                Int
  mes                 Int // 1–12
  ventasNetas         Decimal  @db.Decimal(18, 2) // Ingresos operacionales netos
  costoVenta          Decimal  @db.Decimal(18, 2)
  utilidadBruta       Decimal  @db.Decimal(18, 2)
  gastosOperacionales Decimal  @db.Decimal(18, 2)
  utilidadOperacional Decimal  @db.Decimal(18, 2)
  ingresosNoOp        Decimal  @default(0) @db.Decimal(18, 2)
  egresosNoOp         Decimal  @default(0) @db.Decimal(18, 2)
  utilidadNeta        Decimal  @db.Decimal(18, 2) // Utilidad del ejercicio
  detalle             Json? // árbol de cuentas: [{ seccion, cuenta, valor, nivel }]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([anio, mes])
  @@index([anio, mes])
}

// =============== 11. INVENTARIO DE EQUIPOS ===============
// Equipo (padre) = conjunto físico ubicado en una sede (ej. "Stryker Sistem 8").
// Agrupa sus ítems/accesorios (hijos). El estado se lleva a nivel de ítem
// porque un equipo puede estar activo con un accesorio en reparación.

model EquipoInventario {
  id            Int     @id @default(autoincrement())
  codigo        String? @unique // Código de inventario correlativo por categoría (MOT-001…)
  sede          Sede    @relation(fields: [sedeId], references: [id])
  sedeId        Int
  categoria     String // MOTOR, MOTOR SISTEM 8, CRANEOTOMO, REGULADOR…
  marca         String // HALL, STRYKER, MEDTRONIC MIDAS, PUSM, TRS, SYNTHES…
  nombre        String? // Etiqueta opcional (ej. "Motor Hall #1")
  observaciones String?
  activo        Boolean @default(true) // false cuando el equipo se da de baja completo

  items     ItemInventario[]
  novedades NovedadInventario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId])
  @@index([categoria])
}

model ItemInventario {
  id            Int                @id @default(autoincrement())
  equipo        EquipoInventario   @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  equipoId      Int
  descripcion   String // PIEZA DE MANO, MANGUERA NEGRA, ADAPTADOR HUDSON…
  tipo          TipoItemInventario @default(accesorio)
  cantidad      Int                @default(1)
  lote          String? // Serial / lote (opcional)
  estado        EstadoInventario   @default(activo)
  observaciones String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipoId])
  @@index([estado])
}

// Bitácora de novedades: compra, baja, daño, reparación, retorno y traslado.
// Cada novedad puede afectar todo el equipo o un ítem puntual, y registra la
// transición de estado y/o sede para dejar trazabilidad.
model NovedadInventario {
  id             Int               @id @default(autoincrement())
  fecha          DateTime          @default(now())
  tipo           TipoNovedad
  equipo         EquipoInventario  @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  equipoId       Int
  itemId         Int? // Ítem afectado (opcional; null = todo el equipo)
  sedeOrigenId   Int? // Traslado: sede de origen
  sedeDestinoId  Int? // Traslado / compra: sede destino
  estadoAnterior EstadoInventario?
  estadoNuevo    EstadoInventario?
  descripcion    String?
  usuario        Usuario?          @relation(fields: [usuarioId], references: [id])
  usuarioId      Int?

  createdAt DateTime @default(now())

  @@index([equipoId])
  @@index([tipo])
  @@index([fecha])
}

// =============== 12. NÓMINA ===============
// Maestro de nómina por empleado y año (hojas "SALARIOS <año>" del Excel).
// `total` = costo mensual cargado (salario + aportes patronales + provisiones).
model Nomina {
  id              Int      @id @default(autoincrement())
  anio            Int
  cedula          String
  nombre          String
  proceso         String // área: ADMINISTRATIVO, ALMACEN, ASISTENCIAL, ...
  cargo           String
  empresa         String // BIOSTEEL, SANITHELP, PROVEMEDICS, SELSALUD, COMERCIAL
  ciudad          String
  baseSalarial    Decimal  @db.Decimal(18, 2)
  auxTransporte   Decimal  @default(0) @db.Decimal(18, 2)
  noPrestacional  Decimal  @default(0) @db.Decimal(18, 2)
  totalDevengado  Decimal  @db.Decimal(18, 2)
  seguridadSocial Decimal  @db.Decimal(18, 2) // aportes patronales (subtotal)
  prestaciones    Decimal  @db.Decimal(18, 2) // provisiones (subtotal)
  total           Decimal  @db.Decimal(18, 2) // costo mensual total
  tipoContrato    String
  createdAt       DateTime @default(now())

  @@unique([anio, cedula])
  @@index([anio])
  @@index([empresa])
  @@index([proceso])
}

// =============== 13. NOTAS CRÉDITO (descuento financiero por IPS) ===============
// Parámetros de descuento comercial por IPS/concepto con vigencia (fuente:
// "Parametros Nota Crédito.xlsx"). Los consume el motor de reliquidación de
// ventas para calcular el NOTA_CREDITO por renglón (ver lib/negocio/nota-credito).
model ParametroNotaCredito {
  id          Int      @id @default(autoincrement())
  ips         String // CAMPBELL, BARU, MOVID, VALLE, AZALUD, CM BAHIA, OTRAS_IPS
  concepto    String // BRACE, ALTO_COSTO, MAXILO, APROVECHAMIENTO, MOS, ADRES
  pct         Decimal  @db.Decimal(7, 4)
  fechaInicio DateTime @db.Date
  fechaFin    DateTime @db.Date
  createdAt   DateTime @default(now())

  @@index([ips, concepto])
}

// Facturas excluidas manualmente de cualquier descuento NC (Concepto = "TODOS").
// Editable desde la app; se respeta al reliquidar.
model ExclusionNC {
  id           Int      @id @default(autoincrement())
  nroDocumento String
  concepto     String   @default("TODOS")
  motivo       String?
  createdAt    DateTime @default(now())

  @@unique([nroDocumento, concepto])
  @@index([nroDocumento])
}

// ==========================================================
// Módulo PENDIENTES — datos crudos de S1ESA cargados a diario por la auxiliar
// contable vía formulario con token. Cada carga REEMPLAZA por completo el
// dataset (la descarga es histórica completa). Ver src/lib/negocio/carga-siesa.
// ==========================================================

// DATOS FACTURACIÓN (FET). Grano: documento. ~106k filas.
model FacturacionDoc {
  id                Int       @id @default(autoincrement())
  nroDocumento      String
  fecha             DateTime  @db.Date
  anio              Int
  mes               Int // 1–12
  estado            String
  clienteRazon      String // Razón social cliente factura
  costoPromedio     Decimal   @default(0) @db.Decimal(18, 2)
  subtotal          Decimal   @default(0) @db.Decimal(18, 2) // Valor subtotal local
  impuestos         Decimal   @default(0) @db.Decimal(18, 2) // Valor impuestos local
  neto              Decimal   @default(0) @db.Decimal(18, 2) // Valor neto local
  utilidadPromedio  Decimal   @default(0) @db.Decimal(18, 2)
  sucursal          String? // Desc. sucursal factura
  notasCredito      String? // Notas credito condicionadas
  pedidos           String?
  usuarioAprobacion String? // Usuario aprobacion (indicador clave: # docs x usuario)
  convenio          String?
  fechaCx           DateTime? @db.Date

  @@index([anio, mes])
  @@index([usuarioAprobacion])
  @@index([clienteRazon])
}

// GASTOS. Grano: documento (PVS/PBQ…). ~58k filas.
model GastoDoc {
  id                Int       @id @default(autoincrement())
  nroDocumento      String
  fecha             DateTime  @db.Date
  anio              Int
  mes               Int // 1–12
  estado            String // Cumplido / Pendiente
  clienteRazon      String
  sucursal          String?
  subtotal          Decimal   @default(0) @db.Decimal(18, 2)
  valorBruto        Decimal   @default(0) @db.Decimal(18, 2)
  impuestos         Decimal   @default(0) @db.Decimal(18, 2)
  fechaAprobacion   DateTime? @db.Date
  fechaCumplido     DateTime? @db.Date
  diasFacturacion   Int? // fechaCumplido − fechaAprobacion (para el indicador 0–3 días)
  usuarioAprobacion String?
  fechaCx           DateTime? @db.Date
  convenio          String?
  numeroCaso        String?
  estadoPedidos     String?

  @@index([anio, mes])
  @@index([estado])
}

// MOTIVO FACTURAS ANULADAS (NAN). Grano: documento. Cientos de filas.
model FacturaAnulada {
  id                Int       @id @default(autoincrement())
  nroDocumento      String
  fecha             DateTime  @db.Date
  anio              Int
  mes               Int // 1–12
  clienteRazon      String
  subtotal          Decimal   @default(0) @db.Decimal(18, 2)
  numeroCaso        String?
  paciente          String?
  sucursal          String?
  doc               String? // tipo doc (FET…)
  nFactura          String? // N° Factura
  usuarioAprobacion String?
  fechaFacturaBase  DateTime? @db.Date
  motivo            String?
  descripcion       String?
  responsable       String? // indicador clave: valor x responsable

  @@index([anio, mes])
  @@index([motivo])
  @@index([responsable])
}

// PEDIDOS PENDIENTES ACUMULADOS. Foto (snapshot) del día. Cientos de filas.
model PedidoPendiente {
  id                Int       @id @default(autoincrement())
  nroDocumento      String
  fecha             DateTime  @db.Date
  anio              Int
  mes               Int // 1–12
  estado            String
  clienteRazon      String // IPS
  sucursal          String?
  subtotal          Decimal   @default(0) @db.Decimal(18, 2)
  valorBruto        Decimal   @default(0) @db.Decimal(18, 2)
  impuestos         Decimal   @default(0) @db.Decimal(18, 2)
  fechaAprobacion   DateTime? @db.Date
  fechaCumplido     DateTime? @db.Date
  usuarioAprobacion String?
  fechaCx           DateTime? @db.Date
  convenio          String?
  numeroCaso        String?
  motivoPendiente   String? // Q-códigos (Q2-LISTO PARA FACTURAR…) o texto libre
  responsable       String?

  @@index([clienteRazon])
  @@index([motivoPendiente])
}

// Ventas crudas (reporte "Facturas por ítem", nivel renglón) — fuente única de
// la venta neta. Se cargan incrementales por fecha (formulario) o completas
// (CLI db:ventas); de aquí se recalculan VentaLinea/Cliente/Marca/Dia.
model VentaDoc {
  id         Int      @id @default(autoincrement())
  nro        String
  tipo       String // FET / NAN / NDC…
  aprobada   Boolean  @default(false)
  fecha      DateTime @db.Date
  anio       Int
  mes        Int
  dia        Int
  ips        String?
  suc        String   @default("")
  bod        String   @default("")
  notas      String   @default("")
  conv       String   @default("")
  /// "Desc. lista de precios" del reporte. Es la tarifa que se le aplicó al
  /// renglón; sin ella no se puede saber qué lista deja el ítem en pérdida.
  lista      String   @default("")
  proc       String   @default("")
  linea      String   @default("")
  subtotal   Decimal  @default(0) @db.Decimal(18, 2)
  fbd        String?
  costo      Decimal  @default(0) @db.Decimal(18, 2)
  cliente    String   @default("")
  nit        String?
  marca      String   @default("")
  referencia String   @default("") // código/referencia del ítem (SIESA "Referencia")
  cantidad   Decimal  @default(0) @db.Decimal(18, 2) // unidades del renglón (SIESA "Cantidad")

  @@index([anio, mes])
  @@index([fecha])
}

// Venta neta, costo y cantidad por ÍTEM (referencia) × MARCA × mes.
// Alimenta el "Consumo por Ítem" (desplegable bajo cada proveedor).
// descripcion = "Notas ítem" del reporte; costo unit = costo / cantidad.
model VentaItem {
  id          Int     @id @default(autoincrement())
  anio        Int
  mes         Int // 1–12
  marca       String // p.ej. "1003 - SAMPEDRO"
  referencia  String // código del ítem (p.ej. "TC3550")
  descripcion String // descripción larga (p.ej. "TORNILLO CORTICAL…")
  cantidad    Decimal @default(0) @db.Decimal(18, 2)
  valor       Decimal @db.Decimal(18, 2) // venta neta
  costo       Decimal @default(0) @db.Decimal(18, 2)

  @@unique([anio, mes, marca, referencia])
  @@index([anio, mes])
  @@index([marca])
}

// Venta neta por día (derivada de VentaDoc, misma fórmula que la mensual).
model VentaDia {
  id    Int     @id @default(autoincrement())
  anio  Int
  mes   Int
  dia   Int
  valor Decimal @db.Decimal(18, 2) // venta neta
  costo Decimal @default(0) @db.Decimal(18, 2)

  @@unique([anio, mes, dia])
  @@index([anio, mes])
}

// Bitácora de cada carga por el formulario (auditoría + feedback a la auxiliar).
model CargaSiesa {
  id        Int      @id @default(autoincrement())
  cargadaEn DateTime @default(now())
  ok        Boolean  @default(true)
  resumen   Json // { dataset: { archivo, filas, ... }, errores: [...] }
  mensaje   String?
  origenIp  String?

  @@index([cargadaEn])
}

// ==========================================================
// INVENTARIO DE MATERIAL DE OSTEOSÍNTESIS (SIESA)
// Distinto del inventario de EQUIPOS (models Equipo/ItemInventario).
// Tres fuentes que se cruzan entre sí:
//   · InvBodega     — catálogo (hoja "CÓDIGOS DE BODEGA" de Tablas Auxiliares)
//   · InvBalance    — saldo valorizado mensual, a nivel Ítem × Instalación
//   · InvMovimiento — cada documento, a nivel Referencia × Bodega × Lote
// La instalación es la llave para conciliar balance contra movimientos:
//   101 = material propio · 102 = consignación · 106 = aprovechamiento.
// ==========================================================

// Catálogo de bodegas. `codigo` es TEXTO a propósito: casi todas son
// numéricas pero "INS01" (Instrumentales) no lo es.
// Ojo: la bodega "106" es Selsalud Yopal y NO tiene relación con la
// instalación 106 (aprovechamiento); son numeraciones independientes.
model InvBodega {
  codigo       String  @id
  descripcion  String
  ciudad       String  @default("")
  tipoCompra   String  @default("") // MATERIAL DE OSTEOSINTESIS, ALTO COSTO, INSUMOS…
  modeloCompra String  @default("") // MAYORITARIO, PXP, CONSIGNACIÓN, APROVECHAMIENTO
  instalacion  Int // 101 | 102 | 106
  /**
   * true = la asignación de instalación se dedujo, no vino en el catálogo.
   */
  inferida     Boolean @default(false)

  movimientos InvMovimiento[]

  @@index([instalacion])
  @@index([ciudad])
}

// Saldo mensual valorizado. Una fila por Ítem × Bodega × Instalación × mes.
// Solo se guardan las filas con algún valor distinto de cero (el archivo
// trae ~89.7k filas por mes, de las cuales ~32k tienen saldo o movimiento).
// En la instalación 106 (aprovechamiento) el costo es SIEMPRE 0: hay
// unidades pero nunca valor. No es un error de carga.
model InvBalance {
  id           Int    @id @default(autoincrement())
  anio         Int
  mes          Int // 1–12
  instalacion  Int // 101 | 102 | 103 | 104 | 106
  /// Bodega del saldo. **"" en los meses cargados con el export viejo**, que
  /// solo llegaba hasta instalación. No es FK: el balance trae bodegas que el
  /// catálogo no tiene y la cadena vacía no apuntaría a ninguna.
  bodegaCodigo String @default("")
  item         String // código SIESA del ítem (p.ej. "0000456")
  referencia   String // código corto (p.ej. "PR08")
  descripcion  String @default("")
  tipoInv      String @default("") // "Tipo inventario" (INV143502…)
  marca        String @default("")
  linea        String @default("")
  anatomia     String @default("")
  sistema      String @default("")
  categoria    String @default("")

  cantInicial   Decimal @default(0) @db.Decimal(18, 2)
  cantEntradas  Decimal @default(0) @db.Decimal(18, 2)
  cantSalidas   Decimal @default(0) @db.Decimal(18, 2)
  cantFinal     Decimal @default(0) @db.Decimal(18, 2)
  valorInicial  Decimal @default(0) @db.Decimal(18, 2)
  valorEntradas Decimal @default(0) @db.Decimal(18, 2)
  valorSalidas  Decimal @default(0) @db.Decimal(18, 2)
  valorFinal    Decimal @default(0) @db.Decimal(18, 2)
  /// "Consumo promedio diario" del reporte. SIESA lo entrega casi todo en
  /// cero (16 filas de 89.655 en marzo), así que hoy no es utilizable.
  consumoDiario Decimal @default(0) @db.Decimal(18, 2)

  @@unique([anio, mes, instalacion, bodegaCodigo, item])
  @@index([anio, mes])
  @@index([bodegaCodigo])
  @@index([referencia])
  @@index([marca])
}

// Movimiento de inventario (una línea de documento).
// `tipoDoc` son las 3 primeras letras de `documento`: EPC entrada por compra,
// TIN/TIE/TIS transferencias, ESB ensamble, EDI entrada directa, AIN ajuste,
// REM venta, DVE nota crédito, SII/SIV/SID/SDI salidas, DEC/AEC devoluciones
// y ajustes en compra, ECG entrada en consignación.
model InvMovimiento {
  id           Int      @id @default(autoincrement())
  fecha        DateTime @db.Date
  anio         Int
  mes          Int
  bodegaCodigo String
  /// Instalación que declara el propio export (columna "Instalación").
  /// Los export viejos no la traen: en ese caso se cae a InvBodega.instalacion.
  instalacion  Int?
  referencia   String
  descripcion  String   @default("")
  lote         String   @default("")
  documento    String
  tipoDoc      String // 3 letras
  descTipoDoc  String   @default("")
  ordenInterno String   @default("")

  cantEntradas  Decimal @default(0) @db.Decimal(18, 2)
  cantSalidas   Decimal @default(0) @db.Decimal(18, 2)
  costoEntradas Decimal @default(0) @db.Decimal(18, 2)
  costoSalidas  Decimal @default(0) @db.Decimal(18, 2)
  costoUnit     Decimal @default(0) @db.Decimal(18, 2)

  marca    String @default("")
  linea    String @default("")
  anatomia String @default("")
  usuario  String @default("") // usuario de creación
  notas    String @default("")

  bodega InvBodega @relation(fields: [bodegaCodigo], references: [codigo], onDelete: Cascade)

  @@index([anio, mes])
  @@index([fecha])
  @@index([bodegaCodigo])
  @@index([referencia])
  @@index([tipoDoc])
  @@index([documento])
  @@index([instalacion])
}

// ==========================================================
// ASISTENCIA TÉCNICA — evaluaciones de seguimiento a los asesores
// quirúrgicos dentro del procedimiento. Indicador de calidad.
//
// Se guarda la evaluación cruda (una fila por cirugía evaluada) y todo lo
// demás se calcula: los promedios por mes, por asesor y por ítem, y la
// calificación final. Así el histórico no depende de cómo se agregó.
// ==========================================================
model EvaluacionAsesor {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @db.Date
  anio          Int
  mes           Int
  paciente      String   @default("")
  procedimiento String   @default("")
  ips           String   @default("")
  especialista  String   @default("")
  asesor        String

  // Ítems 1–4, en escala 1–5.
  conocimiento Decimal @db.Decimal(4, 2)
  desempeno    Decimal @db.Decimal(4, 2)
  capacidad    Decimal @db.Decimal(4, 2)
  habilidad    Decimal @db.Decimal(4, 2)

  // Ítems 5–7: true = SÍ hubo. Un "NO" vale 5 puntos (ver METODOLOGIA).
  novedades  Boolean @default(false)
  eventos    Boolean @default(false)
  incidentes Boolean @default(false)

  @@index([anio, mes])
  @@index([asesor])
  @@index([fecha])
}

// Quejas, reclamos y sugerencias del periodo. No sale de las evaluaciones:
// es un dato que se lleva aparte y se digita o se carga por su cuenta.
model PqrsMes {
  id          Int    @id @default(autoincrement())
  anio        Int
  mes         Int
  casos       Int    @default(0)
  observacion String @default("")

  @@unique([anio, mes])
}

// Venta neta, costo y cantidad por ÍTEM × IPS (cliente) × MARCA × mes.
// VentaItem no lleva cliente, así que sin esta tabla el "Consumo por Ítem"
// no se puede filtrar por IPS ni por ciudad.
model VentaItemIps {
  id          Int     @id @default(autoincrement())
  anio        Int
  mes         Int
  marca       String
  referencia  String
  descripcion String
  ips         String // nombre del cliente/IPS tal como viene en la venta
  nit         String? // para cruzar la ciudad contra Tercero
  cantidad    Decimal @default(0) @db.Decimal(18, 2)
  valor       Decimal @db.Decimal(18, 2) // venta neta
  costo       Decimal @default(0) @db.Decimal(18, 2)

  /// Lista de precios aplicada. Entra en la llave: el mismo ítem se le puede
  /// vender a la misma IPS con dos tarifas distintas en el mismo mes, y son
  /// dos márgenes distintos que no hay que sumar en uno solo.
  lista       String  @default("")

  @@unique([anio, mes, marca, referencia, ips, lista])
  @@index([anio, mes])
  @@index([ips])
  @@index([marca])
  @@index([nit])
  @@index([lista])
}

// ==========================================================
// MÓDULO DE COMPRAS
// Réplica del "INFORME DE COMPRAS" de Power BI. Tres fuentes SIESA nuevas,
// más las entradas por compra (EPC) que ya viven en InvMovimiento:
//   · CompraOrden     — órdenes de compra generadas, a nivel renglón
//   · CompraPendiente — pendientes por despacho (foto del día)
//   · CompraFactura   — facturado por proveedor (documentos CCP)
//
// La bodega es TEXTO sin FK a InvBodega a propósito: las órdenes traen
// bodegas que el catálogo no tiene (y con FK se perderían renglones).
// El modelo de compra y la ciudad se resuelven por lookup al consultar.
// ==========================================================

// Renglón de orden de compra. NO hay llave natural única: una misma orden
// puede repetir referencia+bodega (98 casos en 46k). Se carga reemplazando
// el rango de fechas del archivo.
model CompraOrden {
  id           Int      @id @default(autoincrement())
  fechaOrden   DateTime @db.Date
  anio         Int
  mes          Int // 1–12
  dia          Int
  nroOrden     String // OCV / ODC / OCP / OBS
  prefijo      String   @default("") // 3 letras del nro de orden
  bodegaCodigo String   @default("")
  bodegaDesc   String   @default("")
  referencia   String
  descItem     String   @default("")
  cantOrdenada Decimal  @default(0) @db.Decimal(18, 2)
  valorBruto   Decimal  @default(0) @db.Decimal(18, 2)
  valorNeto    Decimal  @default(0) @db.Decimal(18, 2)
  proveedor    String   @default("")
  estado       String   @default("") // Cumplido | Aprobado | Parcial | En elaboración
  tipoDocto    String   @default("") // "Desc. tipo docto."
  notas        String   @default("")
  marca        String   @default("")
  linea        String   @default("")
  anatomia     String   @default("")

  @@index([anio, mes])
  @@index([fechaOrden])
  @@index([nroOrden])
  @@index([proveedor])
  @@index([bodegaCodigo])
  @@index([referencia])
  @@index([estado])
}

// Pendientes por despacho. Es una FOTO del día: cada carga reemplaza todo.
// El KPI del tablero se filtra por `fechaEntrega`, no por `fechaOrden`.
model CompraPendiente {
  id              Int       @id @default(autoincrement())
  nroOrden        String
  itemResumen     String    @default("")
  cantPendiente   Decimal   @default(0) @db.Decimal(18, 2)
  valorPendiente  Decimal   @default(0) @db.Decimal(18, 2)
  bodegaCodigo    String    @default("")
  bodegaDesc      String    @default("")
  cantOrden       Decimal   @default(0) @db.Decimal(18, 2)
  cantEntrada     Decimal   @default(0) @db.Decimal(18, 2)
  entradasRel     String    @default("")
  fechaUltEntrada DateTime? @db.Date
  valorOrden      Decimal   @default(0) @db.Decimal(18, 2)
  doctoReferencia String    @default("")
  fechaEntrega    DateTime? @db.Date
  anio            Int // año de fechaEntrega (o de fechaOrden si no hay)
  mes             Int
  fechaOrden      DateTime? @db.Date
  proveedor       String    @default("")
  marca           String    @default("")
  linea           String    @default("")
  anatomia        String    @default("")
  sistema         String    @default("")
  categoria       String    @default("")
  cargadoEn       DateTime  @default(now())

  @@index([anio, mes])
  @@index([fechaEntrega])
  @@index([nroOrden])
  @@index([proveedor])
  @@index([bodegaCodigo])
}

// Facturado por proveedor (documentos CCP de SIESA). Llave natural:
// el nro de documento interno, que no se repite.
model CompraFactura {
  id               Int       @id @default(autoincrement())
  nroDocumento     String    @unique
  co               String    @default("")
  fecha            DateTime  @db.Date
  anio             Int
  mes              Int
  dia              Int
  estado           String    @default("") // Aprobado | En elaboración | Anulado
  doctoProveedor   String    @default("")
  fechaDoctoProv   DateTime? @db.Date
  claseDocto       String    @default("") // Factura de consignación | Factura de proveedor
  proveedor        String    @default("")
  moneda           String    @default("COP")
  valorBruto       Decimal   @default(0) @db.Decimal(18, 2)
  valorDesctos     Decimal   @default(0) @db.Decimal(18, 2)
  valorImptos      Decimal   @default(0) @db.Decimal(18, 2)
  valorNeto        Decimal   @default(0) @db.Decimal(18, 2)
  valorRetenciones Decimal   @default(0) @db.Decimal(18, 2)
  valorCxp         Decimal   @default(0) @db.Decimal(18, 2)
  notas            String    @default("")
  tipoDocto        String    @default("")
  ciudad           String    @default("") // código de ciudad del documento
  usuarioCreacion  String    @default("")

  @@index([anio, mes])
  @@index([fecha])
  @@index([proveedor])
  @@index([claseDocto])
  @@index([estado])
}

// Catálogo proveedor → TIPO DE COMPRA (ALTO COSTO / BIENES Y SERVICIOS /
// INSUMOS). En Power BI es la tabla "TIPOS DE PROVEEDORES"; aquí se puede
// llenar por carga o editar en la app. Sin fila, el proveedor sale como
// "SIN CLASIFICAR" y el filtro no lo pierde.
model ProveedorCompra {
  razonSocial String  @id
  tipoCompra  String  @default("")
  nit         String?

  @@index([tipoCompra])
}

// Puente DOCUMENTO DE ENTRADA → PROVEEDOR, del reporte "entradas por compra"
// de SIESA. El movimiento de inventario (InvMovimiento) no trae razón social,
// solo la marca; este reporte sí, y su documento (EPC-00068925) es el mismo.
//
// Solo se guarda el nivel documento, no el renglón: el valor y la cantidad
// siguen saliendo de InvMovimiento —que es lo que cuadra con Power BI— y
// duplicarlos aquí crearía dos cifras distintas para lo mismo. El reporte
// valora al precio del documento de compra y el movimiento al costo
// promedio, así que nunca van a coincidir al peso.
//
// Verificado: 3.631 documentos de ene–jul 2026, ninguno con más de un
// proveedor, y el conteo de renglones coincide exacto con InvMovimiento
// (EPC 17.000 · ECG 319 · AEC 285 · DEC 2).
model EntradaProveedor {
  documento String   @id // EPC-00068925 · ECG / AEC / DEC también
  tipoDoc   String   @default("") // 3 letras del documento
  proveedor String
  nit       String?
  fecha     DateTime @db.Date
  anio      Int
  mes       Int

  @@index([proveedor])
  @@index([anio, mes])
}

// =============== ENCUESTAS DE SATISFACCIÓN ===============
// Respuestas de las encuestas de satisfacción (institucional y ortopedistas).
// Cada respuesta guarda sus calificaciones (1–5) por criterio en filas hijas.
model EncuestaSatisfaccion {
  id         Int       @id @default(autoincrement())
  tipo       String    // "institucional" | "ortopedista"
  origenId   String?   // N.º de encuesta (inst) o ID del formulario (ortho)
  fecha      DateTime?
  anio       Int
  cliente    String    // cliente/referencia (inst) o nombre del profesional (ortho)
  cargo      String?   // cargo del encuestado (inst)
  ciudad     String?   // ciudad (ortho)
  recomienda Boolean?  // ortho: ¿recomendaría el servicio?
  createdAt  DateTime  @default(now())

  respuestas EncuestaRespuesta[]

  @@index([tipo, anio])
}

model EncuestaRespuesta {
  id         Int                  @id @default(autoincrement())
  encuesta   EncuestaSatisfaccion @relation(fields: [encuestaId], references: [id], onDelete: Cascade)
  encuestaId Int
  codigo     String // "1.1".."4.4" (inst) u "O1".."O14" (ortho)
  valor      Int    // 1..5

  @@index([encuestaId])
  @@index([codigo])
}

// =============== ASISTENCIA TÉCNICA · CIRUGÍAS ===============
// Una fila por cirugía con asistencia técnica (material de osteosíntesis).
// Fuente: "Consulta Cirugía Diaria" (SIESA) + CiudadCliente. Sin datos del
// paciente (no se requieren para el análisis de volumen/cobertura).
model Cirugia {
  id           Int       @id @default(autoincrement())
  nroDocumento String    @unique
  numeroCaso   String?
  fecha        DateTime?
  anio         Int
  mes          Int
  dia          Int
  co           String?
  convenio     String?
  asesor       String    // nombre del instrumentador, o "SIN SOPORTE"
  sinSoporte   Boolean   @default(false)
  ips          String
  ciudad       String?
  grupo        String?
  medico       String?
  minutos      Int?      // duración de cirugía (opcional)
  createdAt    DateTime  @default(now())

  @@index([anio, mes])
  @@index([asesor])
  @@index([ips])
  @@index([sinSoporte])
}

// ==========================================================
// PEDIDOS — el renglón del pedido que arma el bloque quirúrgico: qué material
// se pidió para cada cirugía, de qué bodega, a qué paciente y con qué médico.
// Es la DEMANDA, y no hay que confundirla con dos vecinas:
//   · PedidoPendiente → pedidos pendientes por facturar (otro reporte).
//   · CompraOrden     → lo que BioSteel le ordena al proveedor.
// El módulo de reposición cruza justamente estas tres con el inventario.
//
// El prefijo del documento identifica la sede/bodega que pide (PBQ, PVS,
// PBR, PBH, PTO, PSF, PJA, PUT, PVN, PVE…).
//
// No hay llave natural: un mismo documento repite referencia cuando el pedido
// trae varios lotes, así que la carga REEMPLAZA LOS MESES presentes en el
// archivo, igual que las órdenes de compra.
// ==========================================================
model Pedido {
  id           Int      @id @default(autoincrement())
  nroDocumento String
  prefijo      String   @default("") // 3 letras del documento (sede que pide)
  fecha        DateTime @db.Date
  anio         Int
  mes          Int // 1–12
  dia          Int
  /// Cumplido | Comprometido | Comprometido parcial | Aprobado | En elaboración
  estado       String   @default("")

  bodegaCodigo    String @default("")
  bodegaDesc      String @default("")
  /// 101 propia · 102 consignación · 106 aprovechamiento (sin costo).
  instalacion     Int?
  instalacionDesc String @default("")

  referencia String
  /// "Notas ítem": la descripción del material en el pedido.
  descItem   String @default("")

  cantPedida Decimal @default(0) @db.Decimal(18, 2)
  /// Existencia que el reporte trae en el momento de exportar. Es una FOTO y
  /// varía por bodega dentro del mismo archivo: sirve de referencia, pero el
  /// inventario bueno para reponer sale de InvBalance.
  cantExist  Decimal @default(0) @db.Decimal(18, 2)
  costoProm  Decimal @default(0) @db.Decimal(18, 2)
  precioUnit Decimal @default(0) @db.Decimal(18, 2)
  valorBruto Decimal @default(0) @db.Decimal(18, 2)
  utilidad   Decimal @default(0) @db.Decimal(18, 2)

  marca     String @default("")
  linea     String @default("")
  anatomia  String @default("")
  sistema   String @default("")
  categoria String @default("")

  procedimiento String    @default("")
  paciente      String    @default("")
  medico        String    @default("")
  fechaCx       DateTime? @db.Date

  cliente       String @default("") // razón social del cliente a facturar
  lista         String @default("") // código de la lista de precios
  listaDesc     String @default("")
  tipoCliente   String @default("")
  ciudad        String @default("") // "Desc. ciudad"
  condicionPago String @default("")

  /// Proveedor del ítem ("Item desc. proveedor"): es la razón social real, no
  /// la marca. Es lo que permite agrupar la sugerencia de compra por a quién
  /// hay que comprarle.
  proveedor    String @default("")
  nitProveedor String @default("")

  @@index([anio, mes])
  @@index([fecha])
  @@index([nroDocumento])
  @@index([referencia])
  @@index([marca])
  @@index([proveedor])
  @@index([estado])
  @@index([ciudad])
  @@index([bodegaCodigo])
  @@index([linea])
}

// =============== RECEPCIÓN TÉCNICA (FOR-ALM-005) ===============
enum TipoRecepcion {
  importacion
  nacional
}

// Verificación documental: Sí / No / N-A.
enum VerifDoc {
  si
  no
  na
}

// Recibo a satisfacción de dispositivos médicos (FOR-ALM-005). Solo registro
// + soporte PDF (no alimenta el inventario todavía).
model RecepcionTecnica {
  id          Int           @id @default(autoincrement())
  tipo        TipoRecepcion
  consecutivo String        @unique // RT-IMP-000001 / RT-NAC-000001

  // 1. Datos de recepción y proveedor
  fechaInspeccion DateTime @db.Date
  odcPedido       String   @default("")
  proveedorNombre String   @default("")
  registroInvima  String   @default("")
  facturaRemision String   @default("")
  valorFactura    Decimal  @default(0) @db.Decimal(18, 2)
  monedaFactura   String   @default("USD") // código de moneda (COP/USD/EUR…)
  guiaTransporte  String   @default("")
  transportador   String   @default("")
  cantOdc         Int?

  // 2. Verificación documental previa
  docFacturaComercial VerifDoc @default(na)
  docPackingList      VerifDoc @default(na)
  docImportacion      VerifDoc @default(na)
  docRsInvima         VerifDoc @default(na)
  docCertCalidad      VerifDoc @default(na)
  docInstruccionesEsp VerifDoc @default(na)
  docCertEsterilidad  VerifDoc @default(na)
  // Condiciones de transporte / embalaje externo
  transSinDanos       Boolean @default(false)
  transConDanos       Boolean @default(false)
  transSelloViolado   Boolean @default(false)
  transTempAdecuada   Boolean @default(false)
  transTempNoAdecuada Boolean @default(false)
  transObservacion    String  @default("")

  // 4. Disposición del lote y decisión final
  resultado         String @default("")
  areaDestino       String @default("")
  decision          String @default("")
  accionTomar       String @default("")
  validacionFactura String @default("")

  // Firmas
  recibidoPor String @default("")
  revisadoPor String @default("")
  aprobadoPor String @default("")

  notas     String   @default("")
  usuarioId Int? // quién lo registró (sin FK: solo trazabilidad)
  createdAt DateTime @default(now())

  items RecepcionItem[]

  @@index([tipo])
  @@index([fechaInspeccion])
}

// Un producto de la inspección física (sección 3).
model RecepcionItem {
  id             Int              @id @default(autoincrement())
  recepcion      RecepcionTecnica @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  recepcionId    Int
  orden          Int              @default(0)
  codigo         String           @default("")
  descripcion    String           @default("")
  cantPedida     Decimal          @default(0) @db.Decimal(18, 2)
  cantRecibida   Decimal          @default(0) @db.Decimal(18, 2)
  lote           String           @default("")
  fechaCaducidad DateTime?        @db.Date
  observaciones  String           @default("")

  criterios RecepcionCriterio[]

  @@index([recepcionId])
}

// Resultado de cada criterio (C1–C8 en importación) por ítem.
// `resultado` = la opción elegida del desplegable del criterio ("Conforme" o
// una causal de no conformidad). `especificacion` se guarda con el registro.
model RecepcionCriterio {
  id             Int           @id @default(autoincrement())
  item           RecepcionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId         Int
  orden          Int           @default(0)
  criterio       String
  especificacion String        @default("")
  resultado      String        @default("Conforme")

  @@index([itemId])
}

// ==========================================================
// INDICADORES DE COMPRAS (FOR-GC-011) — dos indicadores de calidad que hoy
// viven en Excel y los lleva el Líder de Compras:
//   1. % de órdenes de compra recibidas completas (meta > 85 %)
//   2. Evaluación de proveedores sobre 5,0 puntos en seis criterios
//
// No salen de SIESA ni se pueden derivar de CompraOrden: son un conteo y una
// calificación hechos a mano, mes a mes, en el formato de calidad. Por eso
// tienen tabla propia y se cargan desde su Excel.
// ==========================================================

// Un mes del indicador "% de órdenes de compra recibidas completas".
model IndicadorCompraMes {
  id                Int @id @default(autoincrement())
  anio              Int
  mes               Int // 1–12
  ordenesCompletas  Int @default(0)
  ordenesTotales    Int @default(0)

  @@unique([anio, mes])
  @@index([anio])
}

// Catálogo de proveedores activos (hoja "PROVEEDORES ACTIVOS"). Las tres
// columnas del formato son marcas de "tiene el documento al día".
model ProveedorActivo {
  razonSocial       String  @id
  fichaTecnica      Boolean @default(false)
  evaluacionInicial Boolean @default(false)
  seguimiento       Boolean @default(false)
}

// Calificación de un proveedor en un mes. Los seis criterios se guardan
// sueltos para poder ver en cuál se está fallando, no solo el total.
//
// `pct` NO se copia del Excel: se calcula como total / 5. La hoja trae varias
// celdas con 10 en vez de 1,0 y algún porcentaje que quedó desactualizado
// frente a su propio total; el importador las cuenta y las reporta.
model EvaluacionProveedor {
  id        Int    @id @default(autoincrement())
  anio      Int
  mes       Int // 1–12
  proveedor String

  calidad      Decimal @default(0) @db.Decimal(6, 2)
  tiempos      Decimal @default(0) @db.Decimal(6, 2)
  cantidad     Decimal @default(0) @db.Decimal(6, 2)
  precio       Decimal @default(0) @db.Decimal(6, 2)
  postventa    Decimal @default(0) @db.Decimal(6, 2)
  seguimiento  Decimal @default(0) @db.Decimal(6, 2)
  /// Total del formato (sobre 5,0).
  total        Decimal @default(0) @db.Decimal(6, 2)
  /// total / 5, en porcentaje (0–100). Calculado, no copiado.
  pct          Decimal @default(0) @db.Decimal(6, 2)

  @@unique([anio, mes, proveedor])
  @@index([anio, mes])
  @@index([proveedor])
}
