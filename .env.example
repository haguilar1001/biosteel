# ==========================================================
# BioSteel — Variables de entorno (PLANTILLA)
# Copia este archivo a ".env" y completa los valores REALES.
# NUNCA subas el archivo ".env" al repositorio (BIO-SEC-003).
# En Railway, configura estas variables en el panel del servicio.
# ==========================================================

# --- Base de datos (BIO-SEC-014) ---
# Usa la red privada de Railway y TLS. Ejemplo:
# postgresql://usuario:clave@host:5432/biosteel?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/biosteel?schema=public"

# --- Aplicación ---
NODE_ENV="development"
# URL pública de la app (para verificación de origen de Server Actions / CSRF)
APP_URL="http://localhost:3000"

# --- Semilla del administrador inicial (solo para 'db:seed') ---
# Cámbiala tras el primer inicio de sesión. Debe cumplir la política de contraseñas.
SEED_ADMIN_EMAIL="admin@biosteel.co"
SEED_ADMIN_PASSWORD="Cambiar-Esta-Clave-2026!"
SEED_ADMIN_NOMBRE="Administrador BioSteel"

# --- Correo (para notificaciones; si falta, no se envían correos) ---
# RECOMENDADO en Railway: API HTTP de Brevo (viaja por HTTPS/443; el hosting
# suele bloquear los puertos SMTP). Si defines BREVO_API_KEY, se usa la API y
# se ignora la configuración SMTP de abajo. La key se genera en:
# Brevo → SMTP & API → API Keys → Generate a new API key.
# El remitente (SMTP_FROM) debe estar verificado en Brevo (Senders → Add a sender).
BREVO_API_KEY=""
SMTP_FROM="BioSteel <hectoralonsoaguilar@gmail.com>"
# Respaldo SMTP (solo se usa si NO hay BREVO_API_KEY). SMTP_USER = "Login" y
# SMTP_PASS = "SMTP key" (NO la clave de la cuenta), en Brevo → SMTP & API → SMTP.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- Notificaciones / cron ---
# Secreto que protege /api/notificaciones/run (genera uno aleatorio largo).
CRON_SECRET=""
# Destinatarios de los recordatorios (separados por coma):
#   Alejandro Aguilar      -> alejandro.aguilar@biosteeldecolombia.com
#   María Angélica Parejo  -> cooradministrativa@biosteeldecolombia.com (coordinación administrativa)
NOTIF_EMAILS="alejandro.aguilar@biosteeldecolombia.com,cooradministrativa@biosteeldecolombia.com"
# Días de anticipación del recordatorio.
NOTIF_DIAS_ANTES="5"
