{
  "name": "biosteel",
  "version": "0.1.0",
  "private": true,
  "description": "BioSteel de Colombia S.A.S — Sistema de Flujo de Caja (Cartera, CxP, Recaudos, Pagos)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:internos": "tsx prisma/set-internos.ts",
    "db:obligaciones": "tsx prisma/set-obligaciones.ts",
    "db:grupo": "tsx prisma/set-grupo.ts",
    "db:ventas": "node --max-old-space-size=8192 node_modules/tsx/dist/cli.mjs prisma/set-ventas.ts",
    "db:params-nc": "tsx prisma/set-parametros-nc.ts",
    "db:permiso-ventas": "tsx prisma/set-permiso-ventas.ts",
    "db:proveedor-estado": "tsx prisma/set-proveedor-estado.ts",
    "db:pyg": "tsx prisma/set-pyg.ts",
    "db:pyg-excel": "tsx prisma/set-pyg-excel.ts",
    "sync:flujo": "tsx --conditions=react-server prisma/cron-sync-flujo.ts",
    "db:presupuesto": "tsx prisma/set-presupuesto.ts",
    "db:inventario": "tsx prisma/set-inventario.ts",
    "db:codigos": "tsx prisma/set-codigos.ts",
    "db:nomina": "tsx prisma/set-nomina.ts",
    "db:pendientes": "node --max-old-space-size=8192 node_modules/tsx/dist/cli.mjs prisma/set-pendientes.ts",
    "db:check": "tsx prisma/check-datos.ts",
    "db:studio": "prisma studio",
    "audit": "npm audit --audit-level=high",
    "test": "node --import tsx --conditions=react-server --test \"src/**/*.test.ts\"",
    "db:inventario-osteo": "node --max-old-space-size=8192 --import tsx --conditions=react-server prisma/set-inventario-osteo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "leaflet": "^1.9.4",
    "next": "^15.1.4",
    "nodemailer": "^9.0.4",
    "otpauth": "^9.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
